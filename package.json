{
  "name": "graphitab",
  "version": "0.2.0",
  "private": true,
  "description": "GraphiQL in a Tab",
  "license": "MIT",
  "author": "Jason Simeone",
  "type": "module",
  "scripts": {
    "bundle-workers": "node scripts/bundle-workers.mjs",
    "dev": "wxt",
    "predev": "node scripts/bundle-workers.mjs",
    "dev:firefox": "wxt -b firefox",
    "predev:firefox": "node scripts/bundle-workers.mjs",
    "build": "wxt build",
    "prebuild": "node scripts/bundle-workers.mjs",
    "build:firefox": "wxt build -b firefox",
    "prebuild:firefox": "node scripts/bundle-workers.mjs",
    "zip": "wxt zip",
    "prezip": "node scripts/bundle-workers.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "prezip:firefox": "node scripts/bundle-workers.mjs",
    "compile": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "test": "pnpm run compile && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "fullcheck": "pnpm run compile && pnpm run lint && pnpm run format && pnpm run test:coverage",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@graphiql/plugin-explorer": "^5.1.1",
    "@graphiql/react": "^0.37.3",
    "@graphiql/toolkit": "^0.11.3",
    "@microlink/react-json-view": "^1.31.14",
    "filesize": "^11.0.13",
    "graphiql": "^5.2.2",
    "graphql": "^16.13.1",
    "graphql-ws": "^6.0.7",
    "highlight.js": "^11.11.1",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-window": "^2.2.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "^0.27.4",
    "jsdom": "^29.0.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "vitest-localstorage-mock": "^0.1.2",
    "wxt": "^0.20.20"
  },
  "packageManager": "pnpm@10.32.1"
}
